<header>
  <nav class="navbar"> 
    <div class="components-menu">
      
      <div class="components-menu-logo">
        <a href="/">
          <div class="titulo-container">
            <img src="../static/Img/Logo.png" alt="Logo Da Campanha" id="logoimg" />
            <div class="tit">SOL</div>
          </div>
        </a>
      </div>

      <div class="components-menu-center">
        <ul class="nav-links">
          <li><a href="/" value="Home">HOME</a></li>
          <li><a href="/sobre" value="Sobre">SOBRE</a></li>
          <li><a href="/localizacao" value="Localização">LOCALIZAÇÃO</a></li>
          <li>
            <a href="/doacoes_doaruser"
              <% if (!req.session.user) { %>
                value="Doações"
              <% } else { %>
                value="Doações/Doar"
              <% } %>>
              CAMPANHAS
            </a>
          </li>

          <% if (req.session.user && req.session.user.adm === 1) { %>
            <li><a href="/usuariosadm" value="Usuários">USUÁRIOS</a></li>
                 <li><a href="/doacoes_doar" value="Criar">CriarCampanha</a></li>
          <% } %>
        </ul>
      </div>

      <% if (!req.session.user) { %>
          <li><a href="/cadastro"><input type="button" value="Cadastro"></a></li>
          <li><a href="/login"><input type="button" value="Login"></a></li>
      <% } else { %>
          <li><a href="/logout"><input type="button" value="Logout"></a></li>
      <% } %>

      <!-- Botão do menu hamburguer (mobile) -->
      <div class="components-menu-toggle" onclick="toggleMenu()">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </div>

    </div>   
  </nav>
</header>
