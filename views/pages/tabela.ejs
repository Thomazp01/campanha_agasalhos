<!DOCTYPE html>
<html lang="pt-br">
  <%- include("../partials/head"); %>
  <body>
    <%- include("../partials/menu"); %>

    <main>
      <h1>📅 Campanhas</h1>

      <table border="1" cellpadding="5" cellspacing="0">
        <thead>
          <tr>
            <th>Nome da Campanha</th>
            <th>Data de Início</th>
            <th>Data de Término</th>
            <th>Status</th>
            <th>Tempo Restante</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% if (campanhas.length > 0) { %>
            <% campanhas.forEach(c => { %>
              <tr>
                <td><%= c.nome %></td>
                <td><%= c.data_inicio %></td>
                <td><%= c.data_fim %></td>
                <td><%= c.ativa ? 'Ativa' : 'Encerrada' %></td>
                <td>
                  <span class="timer" data-fim="<%= c.data_fim %>"></span>
                </td>
                <td>
                  <form action="/campanhas/<%= c.id %>" method="GET" style="display:inline;">
                    <button <%= c.ativa ? '' : 'disabled' %>>Ver mais</button>
                  </form>

                  <button onclick="window.location.href='/realizardoacaocamp?id_campanha=<%= c.id %>'" <%= c.ativa ? '' : 'disabled' %>>
                    Doar
                  </button>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="6">Nenhuma campanha cadastrada 😕</td></tr>
          <% } %>
        </tbody>
      </table>
    </main>

    <script>
      // Timer dinâmico para cada campanha
      const timers = document.querySelectorAll('.timer');

      function atualizarTimers() {
        const agora = new Date();
        timers.forEach(timerEl => {
          const fim = new Date(timerEl.dataset.fim);
          let diff = fim - agora;

          if (diff <= 0) {
            timerEl.innerText = "0d 0h 0m";
            return;
          }

          const dias = Math.floor(diff / (1000*60*60*24));
          const horas = Math.floor((diff % (1000*60*60*24)) / (1000*60*60));
          const minutos = Math.floor((diff % (1000*60*60)) / (1000*60));

          timerEl.innerText = `${dias}d ${horas}h ${minutos}m`;
        });
      }

      atualizarTimers();
      setInterval(atualizarTimers, 60000); // atualiza a cada minuto
    </script>
  </body>
</html>
